# --- Base de données ---
POSTGRES_USER=cancerscan
POSTGRES_PASSWORD=cancerscan
POSTGRES_DB=cancerscan
DATABASE_URL=postgresql+psycopg://cancerscan:cancerscan@db:5432/cancerscan

# --- Sécurité API ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
# Clé AES-256 (32 octets en base64) pour les données sensibles chiffrées
# Générer : python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
# Clé HMAC pour la détection de doublons (téléphone) sans stocker en clair
LOOKUP_HMAC_KEY=change-me

# --- Moteur IA ---
ENGINE_URL=http://engine:8001
ENGINE_API_KEY=change-me
# true uniquement en développement : autorise les modèles non validés cliniquement
ENGINE_ALLOW_UNVALIDATED=true

# --- Admin initial (créé par `python -m app.seed`) ---
ADMIN_EMAIL=admin@cancerscan.tg
ADMIN_PASSWORD=ChangeMe123!
